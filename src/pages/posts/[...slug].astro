---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import AccentPicker from '../../components/AccentPicker.astro';
import { render } from 'astro:content';
import {
  getPosts, normalizeCategory, postSlug, postDescription, postUrl, isoDay, slugify, seriesParts, relatedPosts,
} from '../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getPosts();
  return allPosts.map((post) => {
    const cleanSlug = postSlug(post.id);

    return {
      params: { slug: cleanSlug },
      props: { post, allPosts },
    };
  });
}

const { post, allPosts } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const category = normalizeCategory(post.data.categories?.[0]);
const series = post.data.series;
const parts = series ? seriesParts(allPosts, series) : [];
const partIndex = parts.findIndex((p) => p.id === post.id);
const prev = series ? parts[partIndex - 1] : allPosts[allPosts.findIndex((p) => p.id === post.id) + 1];
const next = series ? parts[partIndex + 1] : allPosts[allPosts.findIndex((p) => p.id === post.id) - 1];
const related = relatedPosts(post, allPosts);
const slug = postSlug(post.id);
const lastTouched = post.data.updated ?? post.data.date;
const ageYears = (Date.now() - lastTouched.getTime()) / (365.25 * 24 * 3600 * 1000);
const outdated = ageYears >= 2;
const readingTime = remarkPluginFrontmatter?.readingTime || '4 min read';
---

<BaseLayout title={`${post.data.title} — Sahil Singh Rawat`} description={postDescription(post)} type="article" publishedTime={post.data.date.toISOString()} image={`/og/${slug}.png`}>

  <!-- Reading Progress Bar -->
  <div id="scroll-progress" class="fixed top-0 left-0 h-0.5 bg-sky-400 z-[100] w-0 transition-all duration-75 ease-out"></div>

  <!-- Minimal Nav -->
  <header class="border-b border-[var(--border)] bg-[var(--bg-canvas)]/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between text-xs font-mono">
      <a href="/articles/" class="text-[var(--text-muted)] hover:text-[var(--text-high)] flex items-center gap-1.5 transition-colors">
        ← /articles
      </a>
      <div class="flex items-center gap-4">
        <span class="text-[var(--text-muted)]">
          <time datetime={isoDay(post.data.date)}>{isoDay(post.data.date)}</time> · {readingTime}
        </span>
        <div class="hidden sm:flex items-center gap-1" role="group" aria-label="Reading preferences">
          <button type="button" id="fs-down" aria-label="Smaller text" class="h-8 w-8 rounded-md border border-[var(--border)] bg-[var(--bg-surface)] hover:border-[var(--border-hover)] hover:text-[var(--text-high)] text-[var(--text-muted)]">A−</button>
          <button type="button" id="fs-up" aria-label="Larger text" class="h-8 w-8 rounded-md border border-[var(--border)] bg-[var(--bg-surface)] hover:border-[var(--border-hover)] hover:text-[var(--text-high)] text-[var(--text-muted)]">A+</button>
          <button type="button" id="wide-toggle" aria-label="Toggle wide layout" aria-pressed="false" class="hidden lg:block h-8 w-8 rounded-md border border-[var(--border)] bg-[var(--bg-surface)] hover:border-[var(--border-hover)] hover:text-[var(--text-high)] text-[var(--text-muted)]">↔</button>
        </div>
        <button type="button" data-open-palette aria-label="Open command palette" class="hidden md:inline-flex items-center h-8 px-2 rounded-md border border-[var(--border)] bg-[var(--bg-surface)] hover:text-[var(--text-high)] text-[var(--text-muted)]">⌘K</button>
        <AccentPicker />
        <ThemeToggle />
      </div>
    </div>
  </header>

  <!-- Main Grid with Sticky TOC -->
  <div class="max-w-6xl mx-auto px-6 py-16 sm:py-20 lg:grid lg:grid-cols-[minmax(0,1fr)_250px] lg:gap-14">
    <!-- Main Article Column -->
    <main id="main" class="post-main min-w-0 max-w-3xl">
      <header class="mb-14 pb-10 border-b border-[var(--border)] space-y-5">
        <div class="flex items-center gap-3 text-xs font-mono">
          <span class="text-sky-400 font-semibold uppercase tracking-wider">
            {category}
          </span>
          <span class="text-[var(--border)]">/</span>
          <span class="text-[var(--text-muted)]">{readingTime}</span>
          {post.data.updated && (
            <>
              <span class="text-[var(--border)]">/</span>
              <span class="text-[var(--text-muted)]">Updated <time datetime={isoDay(post.data.updated)}>{isoDay(post.data.updated)}</time></span>
            </>
          )}
        </div>

        {series && (
          <a href={`/series/${slugify(series)}/`} class="inline-block text-xs font-mono text-sky-400 hover:underline">
            ◆ {series} — Part {partIndex + 1} of {parts.length}
          </a>
        )}
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--text-high)] tracking-tight leading-[1.2]">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap gap-2 pt-2">
          {post.data.tags.map((tag: string) => (
            <a href={`/tags/${slugify(tag)}/`} class="text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-surface)] border border-[var(--border)] hover:border-sky-400 hover:text-sky-400 px-2.5 py-1 rounded transition-colors">
              #{tag}
            </a>
          ))}
        </div>
      </header>

      {outdated && (
        <div class="outdated-notice" role="note">
          <span aria-hidden="true">⚠</span>
          <p>
            This post was {post.data.updated ? 'last updated' : 'written'} in {lastTouched.getFullYear()}.
            Tools, versions and techniques may have changed since, so double-check before relying on it.
          </p>
        </div>
      )}

      <!-- Content -->
      <article data-pagefind-body data-slug={slug} class="article-content max-w-none text-[17px] sm:text-[18px] text-[var(--text-body)] leading-[1.85]">
        <Content />
      </article>

      <!-- Prev / Next -->
      {(prev || next) && (
        <nav aria-label={series ? 'Series navigation' : 'More articles'} class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {prev ? (
            <a href={postUrl(prev)} class="panel p-4 rounded-lg group">
              <span class="text-xs font-mono text-[var(--text-muted)]">← {series ? 'Previous part' : 'Older'}</span>
              <span class="block mt-1 text-sm font-semibold text-[var(--text-high)] group-hover:text-sky-400 transition-colors">{prev.data.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a href={postUrl(next)} class="panel p-4 rounded-lg group sm:text-right">
              <span class="text-xs font-mono text-[var(--text-muted)]">{series ? 'Next part' : 'Newer'} →</span>
              <span class="block mt-1 text-sm font-semibold text-[var(--text-high)] group-hover:text-sky-400 transition-colors">{next.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}

      {related.length > 0 && (
        <section class="mt-14" aria-labelledby="related-h">
          <h2 id="related-h" class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)] font-bold mb-4">Related articles</h2>
          <ul class="space-y-2">
            {related.map((r) => (
              <li>
                <a href={postUrl(r)} class="text-sm text-[var(--text-body)] hover:text-sky-400 transition-colors">
                  {r.data.title} <span class="font-mono text-xs text-[var(--text-muted)]">· {isoDay(r.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Author Card -->
      <section class="mt-16 pt-10 border-t border-[var(--border)]">
        <div class="panel p-6 sm:p-8 rounded-xl space-y-4">
          <div>
            <h3 class="text-base font-bold text-[var(--text-high)]">Thanks for reading!</h3>
            <p class="text-xs text-[var(--text-muted)] mt-0.5">
              Follow along for more deep-dives into systems engineering, architecture, and security research.
            </p>
          </div>

          <div class="flex flex-wrap gap-2.5 pt-2">
            <a
              href="https://twitter.com/sahil_s_rawat"
              target="_blank"
              rel="noreferrer"
              class="px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-canvas)] hover:border-sky-400 hover:text-sky-400 text-xs font-mono text-[var(--text-body)] transition-all"
            >
              Twitter / X ↗
            </a>
            <a
              href="https://www.linkedin.com/in/sahil-singh-rawat"
              target="_blank"
              rel="noreferrer"
              class="px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-canvas)] hover:border-sky-400 hover:text-sky-400 text-xs font-mono text-[var(--text-body)] transition-all"
            >
              LinkedIn ↗
            </a>
            <a
              href="https://github.com/sahil-rawat"
              target="_blank"
              rel="noreferrer"
              class="px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-canvas)] hover:border-sky-400 hover:text-sky-400 text-xs font-mono text-[var(--text-body)] transition-all"
            >
              GitHub ↗
            </a>
            <a
              href="/"
              class="px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-canvas)] hover:border-sky-400 hover:text-sky-400 text-xs font-mono text-[var(--text-body)] transition-all"
            >
              Overview / Home ↗
            </a>
          </div>
        </div>
      </section>


      <div class="mt-12 pt-8 border-t border-[var(--border)] flex items-center justify-between text-xs font-mono text-[var(--text-muted)]">
        <a href="/articles/" class="text-sky-400 hover:underline">← Back to Articles</a>
        <span>Written by Sahil Singh Rawat</span>
      </div>
    </main>

    <!-- Sticky Table of Contents Sidebar (Desktop) -->
    {filteredHeadings.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-3">
          <h4 class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)] font-bold">
            Table of Contents
          </h4>
          <nav id="toc" aria-label="Table of contents" class="space-y-1 text-xs font-mono border-l border-[var(--border)]">
            {filteredHeadings.map((heading) => (
              <a
                href={`#${heading.slug}`}
                data-toc={heading.slug}
                class={`toc-link block py-1 text-[var(--text-muted)] hover:text-sky-400 hover:border-l hover:border-sky-400 transition-colors ${
                  heading.depth === 3 ? 'pl-6 text-[11px]' : 'pl-3'
                }`}
              >
                {heading.text.replace(/#$/, '')}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    )}
  </div>

  <script is:inline>
    (function () {
      const article = document.querySelector('.article-content');

      // Reading progress + mark-as-read (series tracker)
      const progressBar = document.getElementById('scroll-progress');
      let marked = false;
      function markRead() {
        try {
          const key = 'read-posts';
          const list = JSON.parse(localStorage.getItem(key) || '[]');
          const slug = article && article.dataset.slug;
          if (slug && !list.includes(slug)) {
            list.push(slug);
            localStorage.setItem(key, JSON.stringify(list));
          }
        } catch (e) {}
      }
      window.addEventListener('scroll', () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        if (total <= 0) return;
        const p = window.scrollY / total;
        progressBar.style.width = p * 100 + '%';
        if (!marked && p >= 0.8) { marked = true; markRead(); }
      }, { passive: true });

      // TOC scrollspy
      const tocLinks = [...document.querySelectorAll('.toc-link')];
      if (tocLinks.length && 'IntersectionObserver' in window) {
        const map = new Map(tocLinks.map((a) => [a.dataset.toc, a]));
        const spy = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            tocLinks.forEach((a) => { a.classList.remove('toc-active'); a.removeAttribute('aria-current'); });
            const a = map.get(e.target.id);
            if (a) { a.classList.add('toc-active'); a.setAttribute('aria-current', 'true'); }
          });
        }, { rootMargin: '-80px 0px -70% 0px' });
        [...map.keys()].map((id) => document.getElementById(id)).filter(Boolean).forEach((h) => spy.observe(h));
      }

      // Reader preferences: text size + wide layout
      const root = document.documentElement;
      const sizes = ['-1', '0', '1', '2'];
      const curSize = () => root.getAttribute('data-fs') || '0';
      function setSize(v) {
        if (v === '0') root.removeAttribute('data-fs'); else root.setAttribute('data-fs', v);
        try { localStorage.setItem('reader-fs', v === '0' ? '' : v); } catch (e) {}
      }
      document.getElementById('fs-down')?.addEventListener('click', () => setSize(sizes[Math.max(0, sizes.indexOf(curSize()) - 1)]));
      document.getElementById('fs-up')?.addEventListener('click', () => setSize(sizes[Math.min(sizes.length - 1, sizes.indexOf(curSize()) + 1)]));
      const wideBtn = document.getElementById('wide-toggle');
      const syncWide = () => wideBtn && wideBtn.setAttribute('aria-pressed', String(root.hasAttribute('data-wide')));
      wideBtn?.addEventListener('click', () => {
        const on = !root.hasAttribute('data-wide');
        if (on) root.setAttribute('data-wide', ''); else root.removeAttribute('data-wide');
        try { localStorage.setItem('reader-wide', on ? '1' : '0'); } catch (e) {}
        syncWide();
      });
      syncWide();

      // Code blocks: header with label + copy, collapse long blocks
      document.querySelectorAll('pre.astro-code').forEach((pre) => {
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        pre.parentNode.insertBefore(wrap, pre);

        const head = document.createElement('div');
        head.className = 'code-head';
        const label = document.createElement('span');
        const title = pre.getAttribute('data-title');
        const lang = pre.getAttribute('data-lang');
        label.className = 'code-label' + (title ? ' is-title' : '');
        label.textContent = title || (lang && !['text', 'plaintext', 'txt'].includes(lang) ? lang : 'code');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        head.append(label, btn);
        wrap.append(head, pre);

        btn.addEventListener('click', async () => {
          const code = (pre.querySelector('code') || pre).innerText;
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = 'Copied!';
          } catch (e) { btn.textContent = 'Failed'; }
          setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
        });

        const lines = pre.querySelectorAll('.line').length;
        if (lines > 30) {
          wrap.classList.add('collapsed');
          const more = document.createElement('button');
          more.type = 'button';
          more.className = 'code-expand';
          more.textContent = 'Show all ' + lines + ' lines ↓';
          more.addEventListener('click', () => { wrap.classList.remove('collapsed'); });
          wrap.append(more);
        }
      });

      // Lazy images + click-to-zoom lightbox
      const dlg = document.createElement('dialog');
      dlg.className = 'lightbox';
      dlg.setAttribute('aria-label', 'Image preview');
      const big = document.createElement('img');
      dlg.append(big);
      document.body.append(dlg);
      dlg.addEventListener('click', () => dlg.close());
      document.querySelectorAll('.article-content img').forEach((img) => {
        img.loading = 'lazy';
        img.decoding = 'async';
        if (img.closest('a')) return;
        img.addEventListener('click', () => {
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          dlg.showModal();
        });
      });
    })();
  </script>
</BaseLayout>