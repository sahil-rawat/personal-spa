---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import AccentPicker from '../../components/AccentPicker.astro';
import { render } from 'astro:content';
import {
  getPosts, normalizeCategory, postSlug, postDescription, postUrl, isoDay, slugify, seriesParts, relatedPosts,
} from '../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getPosts();
  return allPosts.map((post) => {
    const cleanSlug = postSlug(post.id);

    return {
      params: { slug: cleanSlug },
      props: { post, allPosts },
    };
  });
}

const { post, allPosts } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const category = normalizeCategory(post.data.categories?.[0]);
const series = post.data.series;
const parts = series ? seriesParts(allPosts, series) : [];
const partIndex = parts.findIndex((p) => p.id === post.id);
const prev = series ? parts[partIndex - 1] : allPosts[allPosts.findIndex((p) => p.id === post.id) + 1];
const next = series ? parts[partIndex + 1] : allPosts[allPosts.findIndex((p) => p.id === post.id) - 1];
const related = relatedPosts(post, allPosts);
const slug = postSlug(post.id);
const lastTouched = post.data.updated ?? post.data.date;
const ageYears = (Date.now() - lastTouched.getTime()) / (365.25 * 24 * 3600 * 1000);
const outdated = ageYears >= 2;
const readingTime = remarkPluginFrontmatter?.readingTime || '4 min read';
---

<BaseLayout title={`${post.data.title} — Sahil Singh Rawat`} description={postDescription(post)} type="article" publishedTime={post.data.date.toISOString()} image={`/og/${slug}.png`}>

  <div id="scroll-progress" class="fixed top-0 left-0 h-0.5 z-[100] w-0 transition-all duration-75 ease-out" style="background: var(--accent-fill)"></div>

  <header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg-canvas)]/85 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between text-sm">
      <a href="/engineering/" class="text-[var(--text-muted)] hover:text-[var(--text-high)] transition-colors">← Engineering</a>
      <div class="flex items-center gap-1.5">
        <div class="hidden sm:flex items-center gap-1.5" role="group" aria-label="Reading preferences">
          <button type="button" id="fs-down" aria-label="Smaller text" class="icon-btn">A−</button>
          <button type="button" id="fs-up" aria-label="Larger text" class="icon-btn">A+</button>
          <button type="button" id="wide-toggle" aria-label="Toggle wide layout" aria-pressed="false" class="icon-btn hidden lg:inline-flex">↔</button>
        </div>
        <button type="button" data-open-palette aria-label="Open command palette" class="icon-btn hidden md:inline-flex">⌘K</button>
        <AccentPicker />
        <ThemeToggle />
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-6 pt-14 sm:pt-20 lg:grid lg:grid-cols-[minmax(0,1fr)_230px] lg:gap-16">
    <main id="main" class="post-main min-w-0 max-w-[44rem]">
      <header class="mb-12 pb-10 border-b border-[var(--border)] space-y-5">
        <p class="label flex flex-wrap items-center gap-x-2">
          <span>{category}</span><span aria-hidden="true">·</span>
          <time datetime={isoDay(post.data.date)}>{isoDay(post.data.date)}</time><span aria-hidden="true">·</span>
          <span>{readingTime}</span>
          {post.data.updated && (<><span aria-hidden="true">·</span><span>Updated <time datetime={isoDay(post.data.updated)}>{isoDay(post.data.updated)}</time></span></>)}
        </p>
        {series && (
          <a href={`/series/${slugify(series)}/`} class="inline-block text-sm text-[var(--text-high)] border-b border-[var(--border-hover)] hover:border-[var(--text-high)]">
            {series} · Part {partIndex + 1} of {parts.length}
          </a>
        )}
        <h1 class="text-[2rem] sm:text-[2.8rem] font-medium tracking-[-0.035em] leading-[1.08] text-[var(--text-high)]">
          {post.data.title}
        </h1>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-x-4 gap-y-1 pt-1">
            {post.data.tags.map((tag: string) => (
              <a href={`/tags/${slugify(tag)}/`} class="tag-link">#{tag}</a>
            ))}
          </div>
        )}
      </header>

      {outdated && (
        <div class="outdated-notice" role="note">
          <span aria-hidden="true">⚠</span>
          <p>
            This post was {post.data.updated ? 'last updated' : 'written'} in {lastTouched.getFullYear()}.
            Tools, versions and techniques may have changed since, so double-check before relying on it.
          </p>
        </div>
      )}

      <article data-pagefind-body data-slug={slug} class="article-content max-w-none text-[17px] sm:text-[18px] text-[var(--text-body)] leading-[1.8]">
        <Content />
      </article>

      {(prev || next) && (
        <nav aria-label={series ? 'Series navigation' : 'More posts'} class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {prev ? (
            <a href={postUrl(prev)} class="panel p-4 rounded-lg">
              <span class="label">← {series ? 'Previous part' : 'Older'}</span>
              <span class="block mt-1 font-medium text-[var(--text-high)]">{prev.data.title}</span>
            </a>
          ) : <span />}
          {next ? (
            <a href={postUrl(next)} class="panel p-4 rounded-lg sm:text-right">
              <span class="label">{series ? 'Next part' : 'Newer'} →</span>
              <span class="block mt-1 font-medium text-[var(--text-high)]">{next.data.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}

      {related.length > 0 && (
        <section class="mt-14" aria-labelledby="related-h">
          <h2 id="related-h" class="label mb-3">Related</h2>
          <div class="rows">
            {related.map((r) => (
              <a href={postUrl(r)} class="row">
                <div class="row-title !text-base min-w-0">{r.data.title}</div>
                <time class="row-date" datetime={isoDay(r.data.date)}>{r.data.date.getFullYear()}</time>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="mt-16 pt-8 border-t border-[var(--border)] text-sm text-[var(--text-muted)] flex flex-wrap items-center justify-between gap-4">
        <p>Thanks for reading. I'm Sahil — <a href="/about/" class="text-[var(--text-high)] border-b border-[var(--text-high)]">more about me</a>.</p>
        <p class="flex gap-4">
          <a href="https://twitter.com/sahil_s_rawat" target="_blank" rel="noreferrer" class="hover:text-[var(--text-high)]">Twitter</a>
          <a href="https://www.linkedin.com/in/sahil-singh-rawat" target="_blank" rel="noreferrer" class="hover:text-[var(--text-high)]">LinkedIn</a>
          <a href="https://github.com/sahil-rawat" target="_blank" rel="noreferrer" class="hover:text-[var(--text-high)]">GitHub</a>
        </p>
      </section>
    </main>

    {filteredHeadings.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-3">
          <h4 class="label">On this page</h4>
          <nav id="toc" aria-label="Table of contents" class="space-y-1 text-[0.8rem] border-l border-[var(--border)]">
            {filteredHeadings.map((heading) => (
              <a
                href={`#${heading.slug}`}
                data-toc={heading.slug}
                class={`toc-link block py-1 -ml-px border-l border-transparent text-[var(--text-muted)] hover:text-[var(--text-high)] transition-colors ${heading.depth === 3 ? 'pl-6 text-xs' : 'pl-3'}`}
              >
                {heading.text.replace(/#$/, '')}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    )}
  </div>

  <footer class="max-w-6xl mx-auto px-6 mt-24 mb-10 text-xs text-[var(--text-muted)]">
    <div class="border-t border-[var(--border)] pt-6">© {new Date().getFullYear()} Sahil Singh Rawat</div>
  </footer>

  <script is:inline>
    (function () {
      const article = document.querySelector('.article-content');

      // Reading progress + mark-as-read (series tracker)
      const progressBar = document.getElementById('scroll-progress');
      let marked = false;
      function markRead() {
        try {
          const key = 'read-posts';
          const list = JSON.parse(localStorage.getItem(key) || '[]');
          const slug = article && article.dataset.slug;
          if (slug && !list.includes(slug)) {
            list.push(slug);
            localStorage.setItem(key, JSON.stringify(list));
          }
        } catch (e) {}
      }
      window.addEventListener('scroll', () => {
        const total = document.documentElement.scrollHeight - window.innerHeight;
        if (total <= 0) return;
        const p = window.scrollY / total;
        progressBar.style.width = p * 100 + '%';
        if (!marked && p >= 0.8) { marked = true; markRead(); }
      }, { passive: true });

      // TOC scrollspy
      const tocLinks = [...document.querySelectorAll('.toc-link')];
      if (tocLinks.length && 'IntersectionObserver' in window) {
        const map = new Map(tocLinks.map((a) => [a.dataset.toc, a]));
        const spy = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            tocLinks.forEach((a) => { a.classList.remove('toc-active'); a.removeAttribute('aria-current'); });
            const a = map.get(e.target.id);
            if (a) { a.classList.add('toc-active'); a.setAttribute('aria-current', 'true'); }
          });
        }, { rootMargin: '-80px 0px -70% 0px' });
        [...map.keys()].map((id) => document.getElementById(id)).filter(Boolean).forEach((h) => spy.observe(h));
      }

      // Reader preferences: text size + wide layout
      const root = document.documentElement;
      const sizes = ['-1', '0', '1', '2'];
      const curSize = () => root.getAttribute('data-fs') || '0';
      function setSize(v) {
        if (v === '0') root.removeAttribute('data-fs'); else root.setAttribute('data-fs', v);
        try { localStorage.setItem('reader-fs', v === '0' ? '' : v); } catch (e) {}
      }
      document.getElementById('fs-down')?.addEventListener('click', () => setSize(sizes[Math.max(0, sizes.indexOf(curSize()) - 1)]));
      document.getElementById('fs-up')?.addEventListener('click', () => setSize(sizes[Math.min(sizes.length - 1, sizes.indexOf(curSize()) + 1)]));
      const wideBtn = document.getElementById('wide-toggle');
      const syncWide = () => wideBtn && wideBtn.setAttribute('aria-pressed', String(root.hasAttribute('data-wide')));
      wideBtn?.addEventListener('click', () => {
        const on = !root.hasAttribute('data-wide');
        if (on) root.setAttribute('data-wide', ''); else root.removeAttribute('data-wide');
        try { localStorage.setItem('reader-wide', on ? '1' : '0'); } catch (e) {}
        syncWide();
      });
      syncWide();

      // Code blocks: header with label + copy, collapse long blocks
      document.querySelectorAll('pre.astro-code').forEach((pre) => {
        const wrap = document.createElement('div');
        wrap.className = 'code-block';
        pre.parentNode.insertBefore(wrap, pre);

        const head = document.createElement('div');
        head.className = 'code-head';
        const label = document.createElement('span');
        const title = pre.getAttribute('data-title');
        const lang = pre.getAttribute('data-lang');
        label.className = 'code-label' + (title ? ' is-title' : '');
        label.textContent = title || (lang && !['text', 'plaintext', 'txt'].includes(lang) ? lang : 'code');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = 'Copy';
        btn.setAttribute('aria-label', 'Copy code to clipboard');
        head.append(label, btn);
        wrap.append(head, pre);

        btn.addEventListener('click', async () => {
          const code = (pre.querySelector('code') || pre).innerText;
          try {
            await navigator.clipboard.writeText(code);
            btn.textContent = 'Copied!';
          } catch (e) { btn.textContent = 'Failed'; }
          setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
        });

        const lines = pre.querySelectorAll('.line').length;
        if (lines > 30) {
          wrap.classList.add('collapsed');
          const more = document.createElement('button');
          more.type = 'button';
          more.className = 'code-expand';
          more.textContent = 'Show all ' + lines + ' lines ↓';
          more.addEventListener('click', () => { wrap.classList.remove('collapsed'); });
          wrap.append(more);
        }
      });

      // Lazy images + click-to-zoom lightbox
      const dlg = document.createElement('dialog');
      dlg.className = 'lightbox';
      dlg.setAttribute('aria-label', 'Image preview');
      const big = document.createElement('img');
      dlg.append(big);
      document.body.append(dlg);
      dlg.addEventListener('click', () => dlg.close());
      document.querySelectorAll('.article-content img').forEach((img) => {
        img.loading = 'lazy';
        img.decoding = 'async';
        if (img.closest('a')) return;
        img.addEventListener('click', () => {
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          dlg.showModal();
        });
      });
    })();
  </script>
</BaseLayout>