---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getPosts, allSeries, seriesParts, slugify, postUrl, postSlug, isoDay } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allSeries(posts).map((name) => ({
    params: { series: slugify(name) },
    props: { name, parts: seriesParts(posts, name) },
  }));
}

const { name, parts } = Astro.props;
---

<BaseLayout title={`${name} — Sahil Singh Rawat`} description={`${parts.length}-part series: ${parts[0].data.title} and more.`}>
  <SiteHeader active="engineering" />
  <main id="main" class="wrap-narrow pt-14 space-y-8">
    <div>
      <a href="/engineering/" class="label hover:text-[var(--text-high)]">← Engineering</a>
      <p class="label mt-6">Series · {parts.length} parts · <span id="read-count" data-total={parts.length}></span></p>
      <h1 class="h-page mt-1">{name}</h1>
    </div>
    <ol class="rows">
      {parts.map((p, i) => (
        <li data-slug={postSlug(p.id)}>
          <a href={postUrl(p)} class="row">
            <div class="min-w-0 flex gap-4 items-baseline">
              <span class="label w-12 shrink-0">Part {i + 1}</span>
              <span class="row-title !text-base">{p.data.title} <span class="read-mark" aria-label="read">✓ read</span></span>
            </div>
            <time datetime={isoDay(p.data.date)} class="row-date hidden sm:block">{isoDay(p.data.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  </main>
  <SiteFooter />
  <script is:inline>
    (function () {
      let read = [];
      try { read = JSON.parse(localStorage.getItem('read-posts') || '[]'); } catch (e) {}
      let n = 0;
      document.querySelectorAll('li[data-slug]').forEach((li) => {
        if (read.includes(li.dataset.slug)) { li.classList.add('is-read'); n++; }
      });
      const el = document.getElementById('read-count');
      if (el) el.textContent = n + ' of ' + el.dataset.total + ' read';
    })();
  </script>
</BaseLayout>
