---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getPosts, allTags } from '../../lib/posts';

const tags = allTags(await getPosts());
---

<BaseLayout title="Tags — Sahil Singh Rawat" description="Browse posts by topic.">
  <SiteHeader active="engineering" />
  <main id="main" class="wrap-narrow pt-14 space-y-8">
    <div>
      <a href="/engineering/" class="label hover:text-[var(--text-high)]">← Engineering</a>
      <h1 class="h-page mt-3">Tags</h1>
    </div>
    <ul class="flex flex-wrap gap-2">
      {tags.map((t) => (
        <li><a href={`/tags/${t.slug}/`} class="chip">#{t.tag} <span class="muted">{t.count}</span></a></li>
      ))}
    </ul>
  </main>
  <SiteFooter />
</BaseLayout>
