---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, allTags, slugify } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === slug)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} — Sahil Singh Rawat`} description={`${posts.length} article${posts.length === 1 ? '' : 's'} tagged ${tag}.`}>
  <SiteHeader active="engineering" />
  <main id="main" class="wrap-narrow pt-14 space-y-8">
    <div>
      <a href="/tags/" class="label hover:text-[var(--text-high)]">← All tags</a>
      <h1 class="h-page mt-3">#{tag}</h1>
      <p class="text-[var(--text-muted)] mt-2">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
    </div>
    <div class="rows">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
