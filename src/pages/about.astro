---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="About — Sahil Singh Rawat" description="Software engineer who enjoys building things and figuring out how they work.">
  <SiteHeader active="about" />
  <main id="main" class="wrap-narrow pt-14 space-y-14">
    <div>
      <h1 class="h-page mb-5">About</h1>
      <p class="text-lg leading-relaxed text-[var(--text-body)]">
        I'm Sahil Singh Rawat, a software engineer who enjoys building things and figuring out how they work.
      </p>
    </div>

    <section aria-labelledby="else-h">
      <h2 id="else-h" class="label mb-3">Elsewhere</h2>
      <p class="text-[var(--text-body)] leading-relaxed">
        I'm active on <a class="border-b border-[var(--text-high)] text-[var(--text-high)]" href="https://www.hackthebox.eu/home/users/profile/303406" rel="noreferrer">Hack The Box</a>{' '}
        and <a class="border-b border-[var(--text-high)] text-[var(--text-high)]" href="https://tryhackme.com/p/sahilrawat" rel="noreferrer">TryHackMe</a>,
        and I take part in CTFs and hackathons.
      </p>
    </section>

    <section id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h" class="label mb-3">Contact</h2>
      <p class="text-[var(--text-body)] leading-relaxed mb-5">Email is the best way to reach me. I read messages on social media too.</p>
      <div class="flex flex-wrap gap-2">
        <a href="mailto:contact@sahilsinghrawat.com" class="chip">Email</a>
        <a href="https://github.com/sahil-rawat" target="_blank" rel="noreferrer" class="chip">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/sahil-singh-rawat" target="_blank" rel="noreferrer" class="chip">LinkedIn ↗</a>
        <a href="https://twitter.com/sahil_s_rawat" target="_blank" rel="noreferrer" class="chip">Twitter / X ↗</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
