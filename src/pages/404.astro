---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Page not found — Sahil Singh Rawat" noindex>
  <SiteHeader />
  <main id="main" class="wrap-narrow pt-24 pb-8">
    <p class="label mb-4">404</p>
    <h1 class="display mb-5">That page <span class="hl">wandered off</span>.</h1>
    <p class="text-lg text-[var(--text-body)] mb-8">It doesn't exist or it has moved.</p>
    <a href="/engineering/" class="btn btn-primary">Browse the writing</a>
  </main>
  <SiteFooter />
</BaseLayout>
