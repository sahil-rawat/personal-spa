---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getPosts, postUrl, isoDay, normalizeCategory } from '../lib/posts';

const posts = await getPosts();
const featured = posts.filter((p) => p.data.featured);
const selected = (featured.length >= 3 ? featured : [...featured, ...posts.filter((p) => !p.data.featured)]).slice(0, 5);
---

<BaseLayout title="Sahil Singh Rawat — Software Engineer & Security Researcher" description="I'm Sahil. I design resilient backends, hunt security bugs, and write about what I learn along the way.">
  <SiteHeader />

  <main id="main">
    <section class="wrap pt-16 sm:pt-24 pb-16 sm:pb-20">
      <p class="eyebrow mb-5">Software engineer · Security researcher</p>
      <h1 class="display mb-6">I build systems,<br />then try to <span class="hl">break them</span>.</h1>
      <p class="text-lg leading-relaxed text-[var(--text-body)] max-w-xl mb-8">
        I'm Sahil. I design resilient backends, hunt security bugs, and write about what I learn along the way.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/engineering/" class="btn btn-primary">Read the writing</a>
        <a href="/about/#contact" class="btn btn-ghost">Say hello →</a>
      </div>
    </section>

    <section class="wrap" aria-labelledby="selected-h">
      <div class="flex items-baseline justify-between mb-3">
        <h2 id="selected-h" class="label">Selected writing</h2>
        <a href="/engineering/" class="text-sm text-[var(--text-high)] border-b border-[var(--text-high)]">All posts</a>
      </div>
      <div class="rows">
        {selected.map((p) => (
          <a href={postUrl(p)} class="row">
            <div class="min-w-0">
              <div class="row-title">{p.data.title}</div>
              <div class="row-meta">{normalizeCategory(p.data.categories?.[0])}</div>
            </div>
            <time class="row-date" datetime={isoDay(p.data.date)}>{p.data.date.getFullYear()}</time>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap mt-20" aria-labelledby="focus-h">
      <h2 id="focus-h" class="label mb-3">What I work on</h2>
      <div class="rows">
        <div class="row"><div><div class="row-title !text-base">Distributed systems and backends</div><div class="row-meta">Service design, concurrency, fault tolerance</div></div></div>
        <div class="row"><div><div class="row-title !text-base">Application security</div><div class="row-meta">Bug bounty, web vulnerabilities, malware analysis</div></div></div>
        <div class="row"><div><div class="row-title !text-base">Runtimes and internals</div><div class="row-meta">JVM, Linux, low-level C, AI and LLM security</div></div></div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
