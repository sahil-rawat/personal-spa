---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getPosts, isoDay, postUrl, normalizeCategory } from '../lib/posts';

const posts = await getPosts();
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="Archive — Sahil Singh Rawat" description={`All ${posts.length} posts, newest first.`}>
  <SiteHeader active="engineering" />
  <main id="main" class="wrap-narrow pt-14 space-y-12">
    <div>
      <a href="/engineering/" class="label hover:text-[var(--text-high)]">← Engineering</a>
      <h1 class="h-page mt-3">Archive</h1>
      <p class="text-[var(--text-muted)] mt-2">{posts.length} posts · <a href="/tags/" class="text-[var(--text-high)] border-b border-[var(--border-hover)]">tags</a> · <a href="/rss.xml" class="text-[var(--text-high)] border-b border-[var(--border-hover)]">RSS</a></p>
    </div>
    {years.map((year) => (
      <section aria-labelledby={`y${year}`}>
        <h2 id={`y${year}`} class="label mb-3">{year}</h2>
        <div class="rows">
          {byYear.get(year)!.map((p) => (
            <a href={postUrl(p)} class="row">
              <div class="min-w-0">
                <div class="row-title !text-base">{p.data.title}</div>
                <div class="row-meta">{normalizeCategory(p.data.categories?.[0])}</div>
              </div>
              <time class="row-date" datetime={isoDay(p.data.date)}>{isoDay(p.data.date).slice(5)}</time>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
  <SiteFooter />
</BaseLayout>
