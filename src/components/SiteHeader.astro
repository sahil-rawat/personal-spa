---
import ThemeToggle from './ThemeToggle.astro';
import AccentPicker from './AccentPicker.astro';
const { active = '' } = Astro.props;
const cur = (name: string) => (active === name ? 'page' : undefined);
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--bg-canvas)]/85 backdrop-blur-md">
  <div class="wrap h-16 flex items-center justify-between">
    <a href="/" class="text-[0.95rem] font-semibold tracking-tight text-[var(--text-high)]" aria-label="Sahil Singh Rawat, home">
      sahil<span class="dot-mark">.</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-4 sm:gap-6 text-sm">
      <a href="/engineering/" class="nav-link" aria-current={cur('engineering')}>Engineering</a>
      <a href="/about/" class="nav-link" aria-current={cur('about')}>About</a>
      <a href="/about/#contact" class="nav-link hidden sm:inline">Contact</a>
      <span class="flex items-center gap-1.5 ml-1">
        <button type="button" data-open-palette aria-label="Open command palette" class="icon-btn hidden md:inline-flex">⌘K</button>
        <AccentPicker />
        <ThemeToggle />
      </span>
    </nav>
  </div>
</header>
