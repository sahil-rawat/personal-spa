---
// Hidden easter egg: Konami code (↑↑↓↓←→←→ B A) or typing "chess" opens a mate-in-one puzzle.
---

<dialog id="chess-egg" aria-label="Chess puzzle" class="chess-egg">
  <div class="chess-box">
    <div class="chess-head">
      <div>
        <p class="chess-title">You found it</p>
        <p id="chess-status" class="chess-sub" aria-live="polite"></p>
      </div>
      <button type="button" id="chess-close" class="icon-btn" aria-label="Close puzzle">✕</button>
    </div>
    <div id="chess-board" class="chess-board" role="group" aria-label="Chess board"></div>
    <div class="chess-actions">
      <button type="button" id="chess-next" class="chip">Another puzzle</button>
      <span class="chess-sub">Solve it and the site's highlight colour changes.</span>
    </div>
  </div>
</dialog>

<script>
  type Puzzle = { fen: string; from: string; to: string; name: string };
  const PUZZLES: Puzzle[] = [
    { name: 'Back-rank mate', fen: '6k1/5ppp/8/8/8/8/5PPP/3R2K1 w - - 0 1', from: 'd1', to: 'd8' },
    { name: "Scholar's mate", fen: 'r1bqkb1r/pppp1ppp/2n2n2/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 0 1', from: 'h5', to: 'f7' },
    { name: 'Smothered mate', fen: '6rk/6pp/8/6N1/8/8/8/6K1 w - - 0 1', from: 'g5', to: 'f7' },
  ];
  const GLYPH: Record<string, string> = { k: '♚', q: '♛', r: '♜', b: '♝', n: '♞', p: '♟' };
  const NAMES: Record<string, string> = { k: 'king', q: 'queen', r: 'rook', b: 'bishop', n: 'knight', p: 'pawn' };

  const dlg = document.getElementById('chess-egg') as HTMLDialogElement;
  const boardEl = document.getElementById('chess-board') as HTMLDivElement;
  const statusEl = document.getElementById('chess-status') as HTMLParagraphElement;
  let puzzle = PUZZLES[0];
  let board: Record<string, string> = {};
  let selected: string | null = null;
  let solved = false;
  let last = -1;

  const sq = (f: number, r: number) => 'abcdefgh'[f] + (r + 1);

  function parse(fen: string) {
    const out: Record<string, string> = {};
    fen.split(' ')[0].split('/').forEach((row, i) => {
      let f = 0;
      for (const ch of row) {
        if (/\d/.test(ch)) f += Number(ch);
        else out[sq(f++, 7 - i)] = ch;
      }
    });
    return out;
  }

  function render() {
    boardEl.innerHTML = '';
    for (let r = 7; r >= 0; r--) {
      for (let f = 0; f < 8; f++) {
        const id = sq(f, r);
        const piece = board[id];
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chess-sq ' + ((f + r) % 2 === 0 ? 'dark' : 'light') + (selected === id ? ' sel' : '');
        b.dataset.sq = id;
        const label = piece
          ? `${id}, ${piece === piece.toUpperCase() ? 'white' : 'black'} ${NAMES[piece.toLowerCase()]}`
          : id;
        b.setAttribute('aria-label', label);
        if (piece) {
          const span = document.createElement('span');
          span.textContent = GLYPH[piece.toLowerCase()];
          span.className = piece === piece.toUpperCase() ? 'w' : 'b';
          b.appendChild(span);
        }
        b.addEventListener('click', () => onSquare(id));
        boardEl.appendChild(b);
      }
    }
  }

  function celebrate() {
    const ids = ['yellow', 'blue', 'green', 'pink', 'orange'];
    const cur = document.documentElement.getAttribute('data-accent') || 'yellow';
    const next = ids.filter((i) => i !== cur)[Math.floor(Math.random() * (ids.length - 1))];
    document.querySelector<HTMLButtonElement>(`[data-accent-id="${next}"]`)?.click();
  }

  function onSquare(id: string) {
    if (solved) return;
    const piece = board[id];
    const isWhite = piece && piece === piece.toUpperCase();
    if (!selected) {
      if (isWhite) { selected = id; statusEl.textContent = 'Pick a square to move to.'; render(); }
      return;
    }
    if (id === selected) { selected = null; statusEl.textContent = 'White to move. Mate in 1.'; render(); return; }
    if (isWhite) { selected = id; render(); return; }
    if (selected === puzzle.from && id === puzzle.to) {
      board[id] = board[selected];
      delete board[selected];
      selected = null;
      solved = true;
      statusEl.textContent = `Checkmate! ${puzzle.name}. Nicely done.`;
      render();
      celebrate();
    } else {
      selected = null;
      statusEl.textContent = 'Not quite. Look for a check the king can’t escape.';
      render();
    }
  }

  function start() {
    let i = Math.floor(Math.random() * PUZZLES.length);
    if (i === last) i = (i + 1) % PUZZLES.length;
    last = i;
    puzzle = PUZZLES[i];
    board = parse(puzzle.fen);
    selected = null;
    solved = false;
    statusEl.textContent = 'White to move. Mate in 1.';
    render();
  }

  function open() {
    if (dlg.open) return;
    start();
    dlg.showModal();
  }

  document.getElementById('chess-close')!.addEventListener('click', () => dlg.close());
  document.getElementById('chess-next')!.addEventListener('click', start);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let kpos = 0;
  let typed = '';
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    kpos = key === KONAMI[kpos] ? kpos + 1 : key === KONAMI[0] ? 1 : 0;
    if (kpos === KONAMI.length) { kpos = 0; open(); return; }
    if (e.key.length === 1) {
      typed = (typed + key).slice(-5);
      if (typed === 'chess') { typed = ''; open(); }
    }
  });
</script>
