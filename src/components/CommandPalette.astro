<dialog id="palette" aria-label="Command palette" class="palette">
  <div class="palette-box">
    <input id="palette-input" type="text" autocomplete="off" spellcheck="false" placeholder="Jump to a page or post…  (Esc to close)" aria-label="Command palette search" />
    <ul id="palette-list" role="listbox"></ul>
    <div class="palette-hint"><span>↑↓ navigate</span><span>↵ open</span><span>esc close</span></div>
  </div>
</dialog>

<script>
  type Item = { label: string; hint: string; run: () => void };
  const dlg = document.getElementById('palette') as HTMLDialogElement;
  const input = document.getElementById('palette-input') as HTMLInputElement;
  const list = document.getElementById('palette-list') as HTMLUListElement;
  let posts: { t: string; u: string; g: string[]; d: string }[] | null = null;
  let shown: Item[] = [];
  let active = 0;

  const go = (url: string) => () => { window.location.href = url; };
  const actions: Item[] = [
    { label: 'Home', hint: 'page', run: go('/') },
    { label: 'Engineering', hint: 'page', run: go('/engineering/') },
    { label: 'Archive by year', hint: 'page', run: go('/articles/') },
    { label: 'Tags', hint: 'page', run: go('/tags/') },
    { label: 'Full-text search', hint: 'page', run: go('/search/') },
    { label: 'About & contact', hint: 'page', run: go('/about/') },
    { label: 'RSS feed', hint: 'page', run: go('/rss.xml') },
    { label: 'Toggle light / dark theme', hint: 'action', run: () => document.getElementById('theme-toggle')?.click() },
    ...['yellow', 'blue', 'green', 'pink', 'orange'].map((a) => ({
      label: `Accent colour: ${a}`, hint: 'action',
      run: () => document.querySelector<HTMLButtonElement>(`[data-accent-id="${a}"]`)?.click(),
    })),
  ];

  function score(q: string, text: string): number {
    const t = text.toLowerCase();
    if (!q) return 1;
    if (t.startsWith(q)) return 100;
    const idx = t.indexOf(q);
    if (idx >= 0) return 60 - Math.min(idx, 50);
    return 0;
  }

  function render() {
    const q = input.value.trim().toLowerCase();
    const items: (Item & { s: number })[] = [
      ...actions.map((a) => ({ ...a, s: score(q, a.label) + (q ? 0 : 0.5) })),
      ...(posts ?? []).map((p) => ({
        label: p.t, hint: p.d, run: go(p.u),
        s: Math.max(score(q, p.t), score(q, p.g.join(' ')) * 0.8),
      })),
    ].filter((x) => x.s > 0);
    items.sort((a, b) => b.s - a.s);
    shown = items.slice(0, 9);
    active = 0;
    list.innerHTML = '';
    shown.forEach((it, i) => {
      const li = document.createElement('li');
      li.setAttribute('role', 'option');
      li.className = i === active ? 'active' : '';
      li.innerHTML = '<span></span><small></small>';
      li.firstElementChild!.textContent = it.label;
      li.lastElementChild!.textContent = it.hint;
      li.addEventListener('click', () => { dlg.close(); it.run(); });
      list.appendChild(li);
    });
    if (!shown.length) list.innerHTML = '<li class="empty">No matches</li>';
  }

  function setActive(n: number) {
    const lis = list.querySelectorAll('li[role=option]');
    if (!lis.length) return;
    active = (n + lis.length) % lis.length;
    lis.forEach((l, i) => l.classList.toggle('active', i === active));
    lis[active].scrollIntoView({ block: 'nearest' });
  }

  async function open() {
    if (dlg.open) return;
    dlg.showModal();
    input.value = '';
    render();
    if (!posts) {
      try { posts = await (await fetch('/palette.json')).json(); render(); } catch { posts = []; }
    }
    input.focus();
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dlg.open ? dlg.close() : open();
    }
  });
  document.querySelectorAll('[data-open-palette]').forEach((b) => b.addEventListener('click', open));
  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); const it = shown[active]; if (it) { dlg.close(); it.run(); } }
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
