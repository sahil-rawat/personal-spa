---
const accents = [
  { id: 'yellow', label: 'Yellow', color: '#ffe45c' },
  { id: 'blue', label: 'Blue', color: '#bfdbfe' },
  { id: 'green', label: 'Green', color: '#bbf7d0' },
  { id: 'pink', label: 'Pink', color: '#fbcfe8' },
  { id: 'orange', label: 'Orange', color: '#fed7aa' },
];
---

<details class="accent-picker relative">
  <summary
    aria-label="Change accent colour"
    class="icon-btn cursor-pointer list-none [&::-webkit-details-marker]:hidden"
  >
    <span class="w-3.5 h-3.5 rounded-full" style="background: var(--accent-fill); border: 1px solid var(--border-hover)"></span>
  </summary>
  <div class="absolute right-0 mt-2 z-[60] flex gap-2 p-2 rounded-lg border border-[var(--border)] bg-[var(--bg-canvas)] shadow-lg">
    {accents.map((a) => (
      <button type="button" data-accent-id={a.id} aria-label={a.label} title={a.label}
        class="w-6 h-6 rounded-full border-2 border-transparent hover:scale-110 transition-transform" style={`background:${a.color}`}></button>
    ))}
  </div>
</details>

<script>
  const root = document.documentElement;
  const KNOWN = ['yellow', 'blue', 'green', 'pink', 'orange'];
  function apply(id: string) {
    if (!KNOWN.includes(id)) id = 'yellow';
    if (id === 'yellow') root.removeAttribute('data-accent');
    else root.setAttribute('data-accent', id);
    try { localStorage.setItem('accent', id); } catch {}
    document.querySelectorAll<HTMLButtonElement>('[data-accent-id]').forEach((b) => {
      b.style.borderColor = b.dataset.accentId === id ? 'var(--text-high)' : 'transparent';
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-accent-id]').forEach((b) => {
    b.addEventListener('click', () => {
      apply(b.dataset.accentId!);
      b.closest('details')?.removeAttribute('open');
    });
  });
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.accent-picker[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });
  apply((() => { try { return localStorage.getItem('accent') || 'yellow'; } catch { return 'yellow'; } })());
</script>
