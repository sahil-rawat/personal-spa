---
import { normalizeCategory, postUrl, isoDay, type Post } from '../lib/posts';
const { post } = Astro.props as { post: Post };
---

<a href={postUrl(post)} class="row">
  <div class="min-w-0">
    <div class="row-title">{post.data.title}</div>
    <div class="row-meta">{normalizeCategory(post.data.categories?.[0])}</div>
  </div>
  <time class="row-date" datetime={isoDay(post.data.date)}>{post.data.date.getFullYear()}</time>
</a>
